APP_NAME=Sixele LMS API
ENVIRONMENT=development
API_PREFIX=/api
MONGO_URL=mongodb://localhost:27017
DB_NAME=sixele_lms
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173

# Background jobs
# notifications.retention_days is managed through system settings; 180 is the default.
# jobs.email_batch_size is managed through system settings; 25 is the default.
